# ==========================================
# FARMPRICE AI / Bharat-VISTAAR Configuration
# ==========================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file containing real credentials to Git!

# Environment mode: 'development' or 'production'
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Snowflake Warehouse & Analytics Layer Configuration
# Set SNOWFLAKE_USE_LOCAL_FALLBACK=false to query live Snowflake Analytical Warehouse
SNOWFLAKE_USE_LOCAL_FALLBACK=false
SNOWFLAKE_ACCOUNT=mdsfbiq-cr91823
SNOWFLAKE_USER=CP
SNOWFLAKE_PASSWORD=your_snowflake_password_here
SNOWFLAKE_WAREHOUSE=FARMPRICE_WH
SNOWFLAKE_DATABASE=FARMPRICE_DB
SNOWFLAKE_SCHEMA=AGRICULTURE
SNOWFLAKE_ROLE=ACCOUNTADMIN

# AGMARKNET & Open Government Data (data.gov.in) Configuration
# Obtain a free official API key at: https://data.gov.in
DATA_GOV_IN_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_BASE_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
SYNC_INTERVAL_MINUTES=60

# Weather API (Optional - defaults to free Open-Meteo API, no key required)
WEATHER_PROVIDER=open-meteo

# Default Calculation Assumptions
DEFAULT_TRANSPORT_PER_KM_PER_QUINTAL=0.85
DEFAULT_LOADING_UNLOADING_PER_QUINTAL=8.0
DEFAULT_MARKET_CESS_PERCENT=1.5

# Geoapify Maps API Configuration
GEOAPIFY_API_KEY=your_geoapify_api_key_here
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here

